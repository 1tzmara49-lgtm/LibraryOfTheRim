<Defs>

<!-- Book base-->

  <ThingDef Name="LibraryBookBase" ParentName="ResourceBase" Abstract="True">
    <description>A book retrieved from the library. If read, the book will burn down, granting you various items that belonged to the booked person.</description>
    <graphicData>
      <texPath>Things/Item/Special/LibraryBook</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <soundInteract>Wood_Drop</soundInteract>
    <soundDrop>Wood_Drop</soundDrop>
    <stackLimit>1</stackLimit>
    <useHitPoints>true</useHitPoints>
    <statBases>
      <Mass>2</Mass>
      <Flammability>1</Flammability>
    </statBases>
    <thingCategories>
      <li>ItemsMisc</li>
    </thingCategories>
    <drawGUIOverlay>false</drawGUIOverlay>
    <tradeability>Sellable</tradeability>
    <techLevel>Ultra</techLevel>
    <tradeTags>
      <li>ExoticMisc</li>
    </tradeTags>
    <comps>
        <li Class="CompProperties_Usable">
          <useJob>libr_burn_book</useJob>
          <useLabel>Read the book</useLabel>
        </li>
    </comps>
  </ThingDef>

